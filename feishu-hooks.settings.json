{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node /apdcephfs_private/qy/projects/whz/agent_notifier/hook-handler.js"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt|idle_prompt|elicitation_dialog",
        "hooks": [
          {
            "type": "command",
            "command": "node /apdcephfs_private/qy/projects/whz/agent_notifier/hook-handler.js"
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node /apdcephfs_private/qy/projects/whz/agent_notifier/hook-handler.js"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node /apdcephfs_private/qy/projects/whz/agent_notifier/live-handler.js"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "node /apdcephfs_private/qy/projects/whz/agent_notifier/ask-handler.js"
          }
        ]
      }
    ]
  }
}
