# 飞书自建应用配置（交互式卡片）
# 获取方法：
# 1. 登录 https://open.feishu.cn 创建企业自建应用
# 2. 获取 App ID 和 App Secret
# 3. 开启机器人能力，在事件订阅中选择长连接模式
# 4. 添加 card.action.trigger 回调事件
# 5. 若要用「飞书发 claude 启动新会话」，还需订阅 im.message.receive_v1 事件，
#    并授予「读取/发送单聊及群组消息」权限（否则机器人收不到你发的 claude 命令）
FEISHU_APP_ID=your_app_id_here
FEISHU_APP_SECRET=your_app_secret_here

# 飞书群组 Chat ID（可选，留空则自动获取机器人所在的第一个群）
# FEISHU_CHAT_ID=

# 默认宿主（claude / codex / cursor）
DEFAULT_AGENT_HOST=claude

# Codex CLI 可执行名（默认 codex）
# CODEX_BIN=codex

# 通知配置
# 是否启用飞书通知 (true/false)
NOTIFICATION_ENABLED=true

# 卡片交互有效期（小时，默认 12）
# NOTIFICATION_EXPIRE_HOURS=12
# 卡片交互有效期（分钟，优先于小时配置；可选）
# FEISHU_CARD_EXPIRE_MINUTES=30

# 卡片显示 Esc 按钮（默认关闭）
# ENABLE_ESC_BUTTON=true

# 是否启用声音提醒 (true/false)
SOUND_ENABLED=true

# tmux 会话目标（可选，仅 tmux 用户需要）
# 格式: session_name:window_index.pane_index (例如 claude:0.0)
# 留空则自动检测终端
# CLAUDE_TMUX_TARGET=

# 实时执行通知（PostToolUse hook，需在 settings.json 中配置 live-handler.js）
# 开启后 Bash/Write/Edit 执行情况实时推送到飞书，整个会话共用一张卡片（原地累积更新）
# 支持值：1/true（全部捕获）或 tools,output,results（精细控制各项内容）
# FEISHU_LIVE_CAPTURE=1
# Debounce 聚合延迟（毫秒，默认 3000，3 秒内无新工具调用则发送）
# FEISHU_LIVE_DEBOUNCE_MS=3000

# ── Cursor（hooks 通道）─────────────────────────────────────────────────────────
# Cursor 与 Claude/Codex 的机制完全不同：它的 hook 是【阻塞式】进程，hook 在 stdout
# 上回一段 JSON 就能决定 Cursor 下一步怎么走。所以 Cursor 的远程控制不经过终端注入，
# 也不需要 pty-relay / cursor() 包装函数——装好 ~/.cursor/hooks.json 即可（install.sh 自动写）。
#
# 通知类（完成卡 / 失败卡 / 实时摘要）默认就开，装完即用。
# 控制类默认【关闭】：它们会真的把 Cursor 挂住等你拍板，坐在电脑前时会莫名卡住
# （beforeShellExecution 对每条命令都触发，包括本来会被自动放行的 ls）。
# 想要远程控制就把下面两个打开，并按需配 matcher 降噪。

# 总开关：设为 0 则 Cursor 相关的卡片全部不发
# CURSOR_NOTIFY_ENABLED=1
# 任务结束时发完成卡（默认开）
# CURSOR_NOTIFY_STOP=1
# 工具失败时发失败卡（默认开；用户主动中断不算失败，不发卡）
# CURSOR_NOTIFY_FAILURE=1

# 【提问形态引导】默认开。会话开始时（sessionStart）注入一条约定：需要用户在若干方案
# 之间做决定时，把选项写进正文并结束本轮，而不是弹 IDE 里的交互式选择题。
# 为什么必须这么做：选择题（AskQuestion）不触发任何 hook、也不结束本轮，人在外面既
# 看不到问题也无法回答，会话就那么静止着。引导成「正文 + 结束本轮」后，问题会落到
# 完成卡上，输入框就能远程作答。设为 0 等于承认选择题永远无法远程控制。
# 注意只对【新建】会话生效，改完要新开窗口。
# CURSOR_STEER_QUESTIONS=1

# 【卡死告警】默认开。agent 说完话之后既不结束本轮、也不再有任何动作，超过阈值就发一张
# 「疑似在等你确认」的提醒卡（多半是停在 IDE 的选择题/确认框上）。
# 判据刻意要求「最后一个事件是 afterAgentResponse」，所以十分钟的编译不会被误报。
# 那张卡不带交互组件 —— 此时没有任何 hook 在等待，摆输入框是骗人。
# CURSOR_STALL_ALERT=1
# CURSOR_STALL_ALERT_SEC=180

# 【强制飞书走代理】默认情况下本仓库会把飞书域名加进 no_proxy，确保直连（本机的
# http_proxy 通常指向境外代理，飞书走它会被 403 拦掉）。但有些机器（公司内网服务器）
# 出网【必须】经代理，飞书直连反而不通 —— 症状是发卡时报
# `Cannot destructure property 'tenant_access_token'`。那种机器上打开这个开关。
# FEISHU_FORCE_PROXY=1

# 【机器标识】卡片落款渲染成 📍<值>。同一个飞书群会同时收到本机与多台远程机的卡片
# （Cursor Remote-SSH 的 hook 跑在远程侧），不标出来分不清该去哪台机器上看。
# 留空则不显示，本机卡片保持原样；远程机上建议填 ssh 的 Host 别名。
# AGENT_NOTIFIER_MACHINE=GY_2

# 【远程审批】在飞书上批准/拒绝 Shell 与 MCP 调用。开启后 Cursor 会等你点，
# 超时则回落到 Cursor 自己的确认弹窗，绝不会永久挂住。
# 注意：这个开关同时决定 hooks.json 里是否注册 beforeShellExecution/beforeMCPExecution
# （关着就不注册，省掉每条命令一次白付的 hook 启动）。改完要重跑 install.sh 或
# npm run cursor:hooks 才会生效。
# 前提：飞书回调由本机的 listener 接。listener 不在本机时这条链路没人接，
# 请改用 npm run cursor:hooks:notify-only。
# CURSOR_REMOTE_APPROVAL=1
# 等待上限（秒，默认 180）。改完请重跑 install.sh —— hooks.json 的 timeout 要跟着变，
# 否则 Cursor 会在你还没回应时就把 hook 杀掉。
# CURSOR_APPROVAL_TIMEOUT_SEC=180
# 只对匹配的命令要审批（JS 正则，留空=所有命令都问，很吵，强烈建议配）
# CURSOR_APPROVAL_MATCHER=rm\s+-rf|git push|npm publish|kubectl|terraform|docker\s+(push|rm)
# 只对匹配的 MCP 调用要审批，匹配对象是 `<服务名>.<工具名>`
# CURSOR_APPROVAL_MCP_MATCHER=^(linear|github)\.
# preToolUse 网关（可选）：默认不接管，因为它对每个工具调用都触发。
# 想用就显式列出工具名，并把 preToolUse 加进 ~/.cursor/hooks.json
# CURSOR_APPROVE_TOOLS=Write,Delete

# 【远程续写】任务结束后在飞书上直接发下一条指令，Cursor 会自动开下一轮。
# 这是「离开电脑也能继续驱动 Cursor」的关键开关。
# CURSOR_REMOTE_FOLLOWUP=1
# 等待上限（秒，默认 300）。同样，改完要重跑 install.sh
# CURSOR_FOLLOWUP_TIMEOUT_SEC=300
# 哪些结束状态才等你续写（默认只有 completed；失败/中断就地收尾，避免把失败循环放大）
# CURSOR_FOLLOWUP_STATUSES=completed
# 子代理（Task 工具）结束时也等你续写（默认关，否则很吵）
# CURSOR_REMOTE_FOLLOWUP_SUBAGENT=1
# 单个会话最多自动续写多少轮（默认 50，写进 hooks.json 的 loop_limit）
# CURSOR_STOP_LOOP_LIMIT=50

# hook 与 listener 的决策交汇目录（默认 /tmp/agent-notifier-decisions）。
# 必须是两个进程都能访问的固定路径 —— 不要改成 $TMPDIR，macOS 上它是按会话分配的。
# AGENT_NOTIFIER_DECISIONS=/tmp/agent-notifier-decisions

# ── Cursor CLI 会话（飞书发起，可随时回复）────────────────────────────────────
# 上面那套 hooks 只能管你在 IDE 里手工开的会话，而且「回话」只有 stop 的瞬时窗口。
# 这一套不一样：在飞书里发 `cursor`（或在任意卡片输入框输 `/cursor`）→ 选项目 →
# 会话由本仓库通过 cursor-agent 拥有，之后【任何时候】都能在卡片输入框继续回话，
# 没有超时、不阻塞、执行中发的指令会自动排队。
#
# 前置：装好并登录 CLI（一次即可，用浏览器登录，不需要 API key）
#   curl https://cursor.com/install -fsS | bash
#   ~/.local/bin/agent login
#
# agent 可执行路径（默认自动探测 ~/.local/bin/agent 等常见位置，找不到才需要指定）。
# 注意 listener 常由 launchd/systemd 拉起，那种环境的 PATH 往往不含 ~/.local/bin，
# 所以这里是按绝对路径探测而不是靠 PATH。
# CURSOR_AGENT_BIN=/Users/you/.local/bin/agent
#
# 指定模型（留空用账号默认，实测会显示成 Auto Balance / 自动路由）
# CURSOR_CLI_MODEL=composer-2.5
#
# 是否自动放行工具调用（默认 1）。设为 0 时 agent 遇到需要批准的命令会停下等人，
# 而飞书发起的会话是无人值守的，等于挂死 —— 所以默认放行。
# 这与 launcher.js 启动 Claude 时用 bypassPermissions 的姿态一致。
# CURSOR_CLI_FORCE=1
#
# 项目列表根目录复用 Claude 的配置（默认 ~/coderepo）
# CLAUDE_LAUNCH_DIR=

# ── 飞书启动 claude 新会话（launcher）─────────────────────────────────────────
# 在飞书里发文本 `claude` → 列本地项目菜单；发 `claude <host>` → 列远程项目菜单。
# 或在任意卡片输入框里输入 `/new`（或 `/new <host>`）也能弹菜单——走卡片回调通道，
# 不依赖 im.message.receive_v1 消息事件权限，更稳。
# 选项目后新开 detached tmux 会话跑：
#   env ENABLE_PROMPT_CACHING_1H=1 <claude> --permission-mode bypassPermissions
# 远程经 claude-remote-shell（需已装 mutagen + 配好 ssh 免密）。
# 需先在飞书后台订阅 im.message.receive_v1（见上方）。
#
# claude 可执行（默认 ~/.local/bin/claude）
# CLAUDE_BIN=
# 启动前 source 的代理脚本（claude 需境外代理访问 Anthropic API；默认 ~/proxy_local.sh，
# 文件不存在则不加代理）。本地与远程(claude-remote-shell)启动都会先 source 它
# CLAUDE_PROXY_SCRIPT=
# 本地项目根目录，列一级子目录为可选项（默认 ~/coderepo）
# CLAUDE_LAUNCH_DIR=
# 远程主机白名单已取消：发 `/new <host>` 或 `claude <host>` 任意主机名都放行
# （仅做注入防护），host 须是本机 ssh 能免密直连的 Host 别名/可解析地址。
# 远程项目根目录（在远程 host 上，默认 ~/coderepo）
# CLAUDE_REMOTE_BASE=~/coderepo
# 远程项目 rsync 到本地的镜像根目录（默认 ~/ClaudeWork）
# CLAUDE_WORK_DIR=
